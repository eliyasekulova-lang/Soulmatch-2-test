APP_ENV=staging
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/soulmatch
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=ops@example.com
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=25
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=15
MESSAGE_SEND_RATE_LIMIT_PER_MINUTE=30
CORS_ALLOW_ORIGINS=https://staging.soulmatch.app,https://staging-admin.soulmatch.app
LOG_LEVEL=INFO
SENTRY_DSN=https://<key>@sentry.io/<project>
SENTRY_ENVIRONMENT=staging
MIN_SIGNUP_AGE_YEARS=18
PII_ENCRYPTION_KEY=replace-with-a-long-random-secret
APP_SUPPORT_EMAIL=support@soulmatch.app
APP_POLICY_BASE_URL=https://staging.soulmatch.app/legal
APP_ACCOUNT_DELETE_URL=https://staging.soulmatch.app/account/delete
SEED_DEMO_CANDIDATES=false
